{
  "name": "fds-entertainment",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "fds-media" }],
  "d1_databases": [{ "binding": "DB", "database_name": "fds-db" }]
}
